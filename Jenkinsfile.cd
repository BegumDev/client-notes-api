pipeline {
    agent {
        label 'docker-agent'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag from CI build')
    }

    environment {
        IMAGE_NAME = "begumdev/client-notes-api"
    }

    stages {
        stage('Fetch CI Artifacts') {
            steps {
                copyArtifacts(
                    projectName: 'client-notes-ci',
                    selector: lastSuccessful()
                )
            }
        }

        stage('Build & Tag Docker Image') {
            steps {
                sh """
                    docker build \
                      -t ${IMAGE_NAME}:${params.IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest \
                      .
                """
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    IMAGE_TAG=${params.IMAGE_TAG} docker compose up -d
                """
            }
        }
    }
}