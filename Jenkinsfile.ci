pipeline {
    agent {
        docker {
            image 'eclipse-temurin:21-jdk'
            label 'docker-agent'
            args '-v maven-repo:/root/.m2'
        }
    }

    environment {
        IMAGE_NAME = "begumdev/client-notes-api"
    }
¬
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x mvnw && ./mvnw -B clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh './mvnw -B test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package Artifacts') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                }
            }
            steps {
                archiveArtifacts artifacts: 'target/quarkus-app/**,Dockerfile,compose.yaml', fingerprint: true
            }
        }

        stage('Trigger CD') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                }
            }
            steps {
                build job: 'client-notes-cd',
                      parameters: [string(name: 'IMAGE_TAG', value: "${env.BUILD_NUMBER}")],
                      wait: false
            }
        }
    }
}