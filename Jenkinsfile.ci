pipeline {
    agent {
        docker {
            image 'maven:3.9.9-eclipse-temurin-21'
            label 'docker-agent'
            args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 1001 --network host -e TESTCONTAINERS_HOST_OVERRIDE=127.0.0.1'
        }
    }

    environment {
        IMAGE_NAME = "begumdev/client-notes-api"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn -B -Dmaven.repo.local=.m2/repository clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn -B -Dmaven.repo.local=.m2/repository test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package Artifacts') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                }
            }
            steps {
                archiveArtifacts artifacts: 'target/quarkus-app/**,Dockerfile,compose.yaml', fingerprint: true
            }
        }

        stage('Trigger CD') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                }
            }
            steps {
                build job: 'client-notes-cd',
                      parameters: [string(name: 'IMAGE_TAG', value: "${env.BUILD_NUMBER}")],
                      wait: false
            }
        }
    }
}
